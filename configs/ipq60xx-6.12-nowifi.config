# =============================================================================
# 目标平台配置
# =============================================================================

# 高通IPQ60xx平台配置
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y       # 禁用多设备配置（仅单设备）

# 硬件优化 - Cortex-A53架构优化
CONFIG_TARGET_OPTIMIZATION="-O3 -pipe -march=armv8-a+crypto+crc -mcpu=cortex-a53+crypto+crc -mtune=cortex-a53"

# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_xiaomi_ax1800=n
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y

# =============================================================================
# 内核配置
# =============================================================================

# 性能与调度
CONFIG_KERNEL_ARM_PMU=y                    # ARM性能监控单元支持
CONFIG_KERNEL_PERF_EVENTS=y                # 性能事件支持
# CONFIG_KERNEL_PREEMPT_RCU is not set     # 禁用抢占RCU

# 内存管理 - 大页支持
# CONFIG_KERNEL_HUGETLBFS is not set           # 禁用大页文件系统（Docker已移除）
# CONFIG_KERNEL_HUGETLB_PAGE is not set        # 禁用大页支持（Docker已移除）
# CONFIG_KERNEL_TRANSPARENT_HUGEPAGE is not set # 禁用透明大页（Docker已移除）
# CONFIG_KERNEL_TRANSPARENT_HUGEPAGE_ALWAYS is not set
CONFIG_KERNEL_MEMCG_SWAP_ENABLED=y         # 内存控制组交换支持

# 控制组(CGroups)支持
CONFIG_KERNEL_CFQ_GROUP_IOSCHED=y          # CFQ组IO调度
CONFIG_KERNEL_CGROUP_DEVICE=y              # 设备控制组
CONFIG_KERNEL_CGROUP_FREEZER=y             # 进程冻结控制组
# CONFIG_KERNEL_CGROUP_HUGETLB is not set  # 禁用 Cgroup 大页（Docker已移除，不需要）
CONFIG_KERNEL_CGROUP_NET_PRIO=y            # 网络优先级控制组
CONFIG_KERNEL_CGROUP_PERF=y                # 性能控制组
CONFIG_KERNEL_NET_CLS_CGROUP=y             # 网络分类控制组

# =============================================================================
# 无线驱动配置 (全部禁用)
# =============================================================================

# CONFIG_ATH11K_NSS_SUPPORT is not set     # 禁用ATH11K NSS支持
# CONFIG_DRIVER_11AC_SUPPORT is not set    # 禁用11AC支持
# CONFIG_DRIVER_11AX_SUPPORT is not set    # 禁用11AX支持

# 禁用所有无线相关包
# CONFIG_PACKAGE_ath11k-firmware-ipq6018 is not set
# CONFIG_PACKAGE_ath11k-firmware-qcn9074 is not set
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_ipq-wifi-cmiot_ax18 is not set
# CONFIG_PACKAGE_ipq-wifi-jdcloud_re-cs-02 is not set
# CONFIG_PACKAGE_ipq-wifi-jdcloud_re-ss-01 is not set
# CONFIG_PACKAGE_ipq-wifi-qihoo_v6 is not set
# CONFIG_PACKAGE_ipq-wifi-redmi_ax5 is not set
# CONFIG_PACKAGE_ipq-wifi-redmi_ax5-jdcloud is not set
# CONFIG_PACKAGE_ipq-wifi-xiaomi_ax1800 is not set
# CONFIG_PACKAGE_ipq-wifi-zn_m2 is not set
# CONFIG_PACKAGE_iw is not set
# CONFIG_PACKAGE_kmod-ath is not set
# CONFIG_PACKAGE_kmod-ath11k is not set
# CONFIG_PACKAGE_kmod-ath11k-ahb is not set
# CONFIG_PACKAGE_kmod-ath11k-pci is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-mhi-bus is not set
# CONFIG_PACKAGE_kmod-qrtr-mhi is not set
# CONFIG_PACKAGE_kmod-qrtr-smd is not set
# CONFIG_PACKAGE_ucode-mod-nl80211 is not set
# CONFIG_PACKAGE_ucode-mod-rtnl is not set
# CONFIG_PACKAGE_wifi-scripts is not set
# CONFIG_PACKAGE_wireless-regdb is not set
# CONFIG_PACKAGE_wpad-openssl is not set

# =============================================================================
# NSS网络子系统配置
# =============================================================================

CONFIG_NSS_FIRMWARE_VERSION_12_2=y         # NSS固件版本12.2
# CONFIG_NSS_FIRMWARE_VERSION_12_5 is not set

# NSS驱动功能
CONFIG_NSS_DRV_IGS_ENABLE=y                # 智能组播支持
CONFIG_NSS_DRV_MAPT_ENABLE=y               # MAP-T支持
CONFIG_NSS_DRV_PPTP_ENABLE=y               # PPTP支持
CONFIG_NSS_DRV_SHAPER_ENABLE=y             # 流量整形支持
# CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE is not set # 禁用WiFi卸载

# =============================================================================
# 核心包配置
# =============================================================================

# 系统工具
CONFIG_PACKAGE_autocore=y                  # 自动核心检测
CONFIG_PACKAGE_btrfs-progs=y               # Btrfs文件系统工具
CONFIG_PACKAGE_ca-certificates=y           # CA证书
CONFIG_PACKAGE_cgroupfs-mount=y            # CGroup文件系统挂载
CONFIG_PACKAGE_curl=y                      # curl工具
CONFIG_PACKAGE_htop=y                      # 进程查看器
CONFIG_PACKAGE_HTOP_LMSENSORS=y            # HTOP传感器支持
CONFIG_PACKAGE_ip-full=y                   # 完整iproute2工具
# CONFIG_PACKAGE_ip-tiny is not set        # 不使用精简版iproute2
CONFIG_PACKAGE_mount-utils=y               # 挂载工具
CONFIG_PACKAGE_opkg=y                      # 包管理器
CONFIG_PACKAGE_resolveip=y                 # IP解析工具
CONFIG_PACKAGE_terminfo=y                  # 终端信息
CONFIG_PACKAGE_tcpdump=y                   # 网络抓包工具
CONFIG_PACKAGE_netperf=y                   # 网络性能测试工具

# 网络工具
CONFIG_PACKAGE_etherwake=y                 # 网络唤醒
CONFIG_PACKAGE_ip6tables-nft=y             # IPv6防火墙(nftables)
CONFIG_PACKAGE_iptables-mod-extra=y        # 额外iptables模块
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y # 连接跟踪扩展
CONFIG_PACKAGE_iptables-mod-tproxy=y       # 透明代理支持
CONFIG_PACKAGE_iptables-nft=y              # iptables nft后端
CONFIG_PACKAGE_xtables-nft=y               # xtables nft兼容

# 性能测试
CONFIG_PACKAGE_coremark=y                  # CoreMark性能测试
CONFIG_COREMARK_ENABLE_MULTITHREADING=y    # 多线程CoreMark
CONFIG_COREMARK_NUMBER_OF_THREADS=16       # CoreMark 线程数: 16
CONFIG_COREMARK_OPTIMIZE_O3=y              # O3优化

# =============================================================================
# 内核模块配置
# =============================================================================

# 网络模块
CONFIG_PACKAGE_kmod-br-netfilter=y         # 网桥netfilter
CONFIG_PACKAGE_kmod-dummy=y                # 虚拟网络设备
CONFIG_PACKAGE_kmod-ifb=y                  # 中间功能块
CONFIG_PACKAGE_kmod-inet-diag=y            # 网络诊断
CONFIG_PACKAGE_kmod-ip6tables=y            # IPv6防火墙
CONFIG_PACKAGE_kmod-ipt-conntrack=y        # 连接跟踪
CONFIG_PACKAGE_kmod-ipt-core=y             # iptables核心
CONFIG_PACKAGE_kmod-ipt-extra=y            # 额外iptables模块
CONFIG_PACKAGE_kmod-ipt-nat=y              # NAT支持
CONFIG_PACKAGE_kmod-ipt-nat6=y             # IPv6 NAT
CONFIG_PACKAGE_kmod-ipt-physdev=y          # 物理设备匹配
# CONFIG_PACKAGE_kmod-macvlan is not set       # 禁用 MACVLAN（Docker已移除）
CONFIG_PACKAGE_kmod-nat46=y                # NAT46转换
CONFIG_PACKAGE_kmod-netlink-diag=y         # Netlink诊断
CONFIG_PACKAGE_kmod-nf-ipt=y               # netfilter iptables
CONFIG_PACKAGE_kmod-nf-ipt6=y              # netfilter IPv6
# CONFIG_PACKAGE_kmod-nf-ipvs is not set       # 禁用 IPVS（Docker负载均衡，已移除）
CONFIG_PACKAGE_kmod-nf-nat6=y              # IPv6 NAT
CONFIG_PACKAGE_kmod-nf-socket=y            # socket匹配
CONFIG_PACKAGE_kmod-nf-tproxy=y            # 透明代理
CONFIG_PACKAGE_kmod-nft-compat=y           # nftables兼容
CONFIG_PACKAGE_kmod-nft-socket=y           # nftables socket匹配
CONFIG_PACKAGE_kmod-nft-tproxy=y           # nftables透明代理
CONFIG_PACKAGE_kmod-sched-core=y           # 调度器核心
CONFIG_PACKAGE_kmod-sched-cake=y           # CAKE QoS算法
CONFIG_PACKAGE_kmod-sched-connmark=y       # 连接标记调度
CONFIG_PACKAGE_kmod-tun=y                  # TUN/TAP设备
# CONFIG_PACKAGE_kmod-veth is not set          # 禁用 veth（Docker容器网络，已移除）
CONFIG_PACKAGE_kmod-wireguard=y            # WireGuard VPN

# 文件系统模块
CONFIG_PACKAGE_kmod-fs-btrfs=y             # Btrfs文件系统

# 加密模块
CONFIG_PACKAGE_kmod-crypto-acompress=y     # 异步压缩
CONFIG_PACKAGE_kmod-crypto-blake2b=y       # BLAKE2b哈希
CONFIG_PACKAGE_kmod-crypto-kpp=y           # 密钥协议协议
CONFIG_PACKAGE_kmod-crypto-lib-chacha20=y  # ChaCha20算法
CONFIG_PACKAGE_kmod-crypto-lib-chacha20poly1305=y # ChaCha20-Poly1305
CONFIG_PACKAGE_kmod-crypto-lib-curve25519=y # Curve25519算法
CONFIG_PACKAGE_kmod-crypto-lib-poly1305=y  # Poly1305认证
CONFIG_PACKAGE_kmod-crypto-xxhash=y        # xxHash算法

# 库模块
CONFIG_PACKAGE_kmod-lib-lzo=y              # LZO压缩
CONFIG_PACKAGE_kmod-lib-raid6=y            # RAID6算法
CONFIG_PACKAGE_kmod-lib-xor=y              # XOR优化
CONFIG_PACKAGE_kmod-lib-xxhash=y           # xxHash库
CONFIG_PACKAGE_kmod-lib-zlib-deflate=y     # zlib压缩
CONFIG_PACKAGE_kmod-lib-zlib-inflate=y     # zlib解压
CONFIG_PACKAGE_kmod-lib-zstd=y             # Zstandard压缩

# SCSI和硬件模块
CONFIG_PACKAGE_kmod-scsi-core=y            # SCSI核心

# USB支持
CONFIG_PACKAGE_kmod-usb-dwc2=y             # DWC2 USB控制器
CONFIG_PACKAGE_kmod-usb-dwc2-pci=y         # PCI DWC2 USB
CONFIG_PACKAGE_kmod-usb-ehci=y             # EHCI USB
CONFIG_PACKAGE_kmod-usb-ohci=y             # OHCI USB
CONFIG_PACKAGE_kmod-usb-phy-nop=y          # USB PHY空驱动
CONFIG_PACKAGE_kmod-usb-roles=y            # USB角色切换
CONFIG_PACKAGE_kmod-usb-storage=y          # USB存储
CONFIG_PACKAGE_kmod-usb-storage-extras=y   # USB存储扩展
CONFIG_PACKAGE_kmod-usb-uhci=y             # UHCI USB
CONFIG_PACKAGE_kmod-usb2=y                 # USB 2.0
CONFIG_PACKAGE_kmod-usb2-pci=y             # PCI USB 2.0
CONFIG_PACKAGE_kmod-usb3=y                 # USB 3.0
CONFIG_PACKAGE_kmod-usb-xhci=y             # xHCI USB

# NSS驱动模块
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y      # 智能组播
CONFIG_PACKAGE_kmod-qca-nss-drv-lag-mgr=y  # 链路聚合管理
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y    # PPPoE加速
CONFIG_PACKAGE_kmod-qca-nss-drv-map-t=y    # MAP-T支持
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y    # 队列规则
CONFIG_PACKAGE_kmod-qca-nss-macsec=y       # MACsec支持

# =============================================================================
# LuCI Web界面配置
# =============================================================================

# 基础LuCI组件
CONFIG_PACKAGE_luci=y                      # LuCI核心
CONFIG_PACKAGE_luci-base=y                 # LuCI基础库
CONFIG_PACKAGE_luci-compat=y               # LuCI兼容层
CONFIG_PACKAGE_luci-light=y                # 轻量版LuCI
CONFIG_PACKAGE_luci-lua-runtime=y          # Lua运行时
CONFIG_PACKAGE_luci-mod-admin-full=y       # 完整管理模块
CONFIG_PACKAGE_luci-mod-network=y          # 网络模块
CONFIG_PACKAGE_luci-mod-status=y           # 状态模块
CONFIG_PACKAGE_luci-mod-system=y           # 系统模块
CONFIG_PACKAGE_luci-proto-ipv6=y           # IPv6协议
CONFIG_PACKAGE_luci-proto-ppp=y            # PPP协议
CONFIG_PACKAGE_luci-proto-wireguard=y      # WireGuard协议

# 主题
CONFIG_PACKAGE_luci-theme-argon=y          # Argon主题
CONFIG_PACKAGE_luci-app-argon-config=y     # Argon主题配置
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y # Argon主题中文
CONFIG_PACKAGE_luci-theme-bootstrap=y

# LuCI应用
CONFIG_PACKAGE_luci-app-firewall=y         # 防火墙
CONFIG_PACKAGE_luci-app-package-manager=y  # 软件包管理
CONFIG_PACKAGE_luci-app-upnp=y             # UPnP支持
CONFIG_PACKAGE_luci-app-wol=y              # 网络唤醒
CONFIG_PACKAGE_luci-app-chinadns-ng=y      # ChinaDNS-NG
CONFIG_PACKAGE_luci-app-athena-led=n       # 禁用 LED 控制（仅RE-CS-02需要）

# 语言支持
CONFIG_LUCI_LANG_zh_Hans=y                 # 简体中文
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y      # 基础中文
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y  # 防火墙中文
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y # 包管理中文
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y      # UPnP中文
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y       # 网络唤醒中文
# CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn is not set  # 禁用 LED 控制中文

# =============================================================================
# 库文件配置
# =============================================================================

# 基础库
CONFIG_PACKAGE_libattr=y                   # 文件属性库
CONFIG_PACKAGE_libcap=y                    # 权限控制库
CONFIG_PACKAGE_libcap-ng=y                 # 新权限控制库
CONFIG_PACKAGE_libiptext=y                 # iptables扩展文本
CONFIG_PACKAGE_libiptext-nft=y             # nftables扩展文本
CONFIG_PACKAGE_libiptext6=y                # IPv6 iptables扩展
CONFIG_PACKAGE_liblzo=y                    # LZO压缩库
CONFIG_PACKAGE_libmount=y                  # 挂载库
CONFIG_PACKAGE_libncurses=y                # 终端控制库
CONFIG_PACKAGE_libseccomp=y                # 系统调用过滤
CONFIG_PACKAGE_libubus-lua=y               # UBUS Lua绑定
CONFIG_PACKAGE_libuv=y                     # 异步IO库
CONFIG_PACKAGE_libwebsockets-full=y        # WebSocket库(完整版)
CONFIG_PACKAGE_libxtables=y                # xtables库

# Lua相关
CONFIG_PACKAGE_lua=y                       # Lua解释器
CONFIG_PACKAGE_liblua=y                    # Lua库
CONFIG_PACKAGE_liblucihttp=y               # LuCI HTTP库
CONFIG_PACKAGE_liblucihttp-lua=y           # LuCI HTTP Lua绑定
CONFIG_PACKAGE_liblucihttp-ucode=y         # LuCI HTTP ucode绑定

# LuCI库
CONFIG_PACKAGE_luci-lib-base=y             # LuCI基础库
CONFIG_PACKAGE_luci-lib-ip=y               # LuCI IP库
CONFIG_PACKAGE_luci-lib-jsonc=y            # JSON-C库
CONFIG_PACKAGE_luci-lib-nixio=y            # NixIO库
CONFIG_PACKAGE_luci-lib-uqr=y              # 二维码库

# =============================================================================
# 服务配置
# =============================================================================

# Web服务
CONFIG_PACKAGE_uhttpd=y                    # uHTTPd服务器
CONFIG_PACKAGE_uhttpd-mod-ubus=y           # UBUS支持

# RPC服务
CONFIG_PACKAGE_rpcd=y                      # RPC守护进程
CONFIG_PACKAGE_rpcd-mod-file=y             # 文件RPC模块
CONFIG_PACKAGE_rpcd-mod-iwinfo=y           # 无线信息RPC
CONFIG_PACKAGE_rpcd-mod-luci=y             # LuCI RPC模块
CONFIG_PACKAGE_rpcd-mod-rrdns=y            # 反向DNS RPC
CONFIG_PACKAGE_rpcd-mod-ucode=y            # ucode RPC模块

# CGI支持
CONFIG_PACKAGE_cgi-io=y                    # CGI IO处理

# =============================================================================
# 网络服务配置
# =============================================================================

# DNS相关
CONFIG_PACKAGE_chinadns-ng=y               # ChinaDNS-NG DNS 分流
CONFIG_PACKAGE_smartdns=n                  # 禁用SmartDNS
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_sing-box=y 

# 代理相关
CONFIG_PACKAGE_sing-box=y                  # Sing-box代理
CONFIG_SING_BOX_BUILD_ACME=y               # ACME支持
CONFIG_SING_BOX_BUILD_CLASH_API=y          # Clash API支持
CONFIG_SING_BOX_BUILD_ECH=y                # ECH支持
CONFIG_SING_BOX_BUILD_GVISOR=y             # gVisor支持
CONFIG_SING_BOX_BUILD_QUIC=y               # QUIC支持
CONFIG_SING_BOX_BUILD_REALITY_SERVER=y     # Reality服务器
CONFIG_SING_BOX_BUILD_UTLS=y               # uTLS支持
CONFIG_SING_BOX_BUILD_WIREGUARD=y          # WireGuard支持

CONFIG_PACKAGE_luci-app-homeproxy=n        # 禁用HomeProxy

# VPN相关
CONFIG_PACKAGE_wireguard-tools=y           # WireGuard工具

# UPnP
CONFIG_PACKAGE_miniupnpd-nftables=y        # nftables UPnP

# =============================================================================
# 容器支持 (全部禁用)
# =============================================================================

CONFIG_DOCKER_CGROUP_OPTIONS=n
CONFIG_DOCKER_NET_MACVLAN=n
CONFIG_DOCKER_OPTIONAL_FEATURES=n
CONFIG_DOCKER_STO_EXT4=n
CONFIG_PACKAGE_containerd=n
CONFIG_PACKAGE_docker=n
CONFIG_PACKAGE_docker-compose=n
CONFIG_PACKAGE_dockerd=n
CONFIG_PACKAGE_luci-app-dockerman=n
CONFIG_PACKAGE_luci-lib-docker=n
CONFIG_PACKAGE_runc=n
CONFIG_PACKAGE_tini=n

# =============================================================================
# 终端服务 (禁用)
# =============================================================================

CONFIG_PACKAGE_luci-app-ttyd=n
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=n
CONFIG_PACKAGE_ttyd=n

# =============================================================================
# 加密库配置 (mbedTLS)
# =============================================================================

CONFIG_PACKAGE_libmbedtls=m               # mbedTLS库
CONFIG_MBEDTLS_AES_C=y                     # AES加密
CONFIG_MBEDTLS_CMAC_C=y                    # CMAC认证
CONFIG_MBEDTLS_DES_C=y                     # DES加密
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y # Curve25519椭圆曲线
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=y  # secp256k1曲线
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y  # secp256r1曲线
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=y  # secp384r1曲线
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=y  # secp521r1曲线
CONFIG_MBEDTLS_ENTROPY_FORCE_SHA256=y      # 强制SHA256熵
CONFIG_MBEDTLS_GCM_C=y                     # GCM加密模式
CONFIG_MBEDTLS_HKDF_C=y                    # HKDF密钥派生
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED=y # ECDHE_ECDSA密钥交换
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_PSK_ENABLED=y # ECDHE_PSK密钥交换
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED=y # ECDHE_RSA密钥交换
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK_ENABLED=y  # PSK密钥交换
CONFIG_MBEDTLS_NIST_KW_C=y                 # NIST密钥包装
CONFIG_MBEDTLS_RSA_NO_CRT=y                # RSA无CRT优化
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y          # TLS 1.2支持
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y          # TLS 1.3支持
CONFIG_MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE=y # TLS 1.3兼容模式
CONFIG_MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED=y # 临时密钥交换
CONFIG_MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ENABLED=y # PSK密钥交换
CONFIG_MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL_ENABLED=y # PSK临时密钥
CONFIG_MBEDTLS_THREADING_C=y               # 线程支持
CONFIG_MBEDTLS_THREADING_PTHREAD=y         # pthread线程

# 禁用OpenSSL
# CONFIG_PACKAGE_apk-mbedtls=n
# CONFIG_PACKAGE_apk-openssl is not set
# CONFIG_PACKAGE_libopenssl-conf is not set
# CONFIG_PACKAGE_libopenssl-legacy is not set
CONFIG_LIBCURL_MBEDTLS=n

# =============================================================================
# 自定义配置
# =============================================================================

CONFIG_PACKAGE_momo=y                      # 自定义momo应用
CONFIG_PACKAGE_luci-app-momo=y             # momo的LuCI界面
CONFIG_PACKAGE_default-settings=y          # 默认设置
CONFIG_PACKAGE_default-settings-chn=y      # 中国区默认设置

# 内存压缩交换
CONFIG_PACKAGE_zram-swap=y                 # ZRAM交换

# ucode模块
CONFIG_PACKAGE_ucode-mod-html=y            # HTML模板
CONFIG_PACKAGE_ucode-mod-lua=y             # Lua支持
CONFIG_PACKAGE_ucode-mod-math=y            # 数学函数
# CONFIG_PACKAGE_ucode-mod-uloop is not set # 禁用事件循环

# 包管理器选项
CONFIG_OPKG_USE_CURL=y                     # curl下载支持
CONFIG_USE_APK=n                           # 禁用APK包管理器

# 根文件系统
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set # 禁用initramfs

# 去除值式固件更新
# CONFIG_PACKAGE_luci-app-attendedsysupgrade is not set
# CONFIG_PACKAGE_attendedsysupgrade-common is not set
# CONFIG_PACKAGE_attendedsysupgrade is not set